{
    "manifest_version": 3,
    "name": "AI Answer Generator",
    "version": "1.0",
    "description": "Right-click selected text to generate an AI answer.",
    "permissions": [
      "contextMenus",
      "scripting",
      "activeTab",
      "storage"
    ],
    "host_permissions": [
      "https://api.openai.com/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html"
      
    }
  }
  