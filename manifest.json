{
  "manifest_version": 3,
  "name": "AI Answer Generator",
  "version": "1.5",
  "description": "Generates AI answers from selected text using Ollama's LLaMA 3 model",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:11434/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
